{
  "schemaVersion": 1,
  "id": "stash-hunter",
  "version": "${version}",
  "name": "StashhunterPort by _og3",
  "description": "A Meteor client addon for finding stashes on anarchy servers. Fork/port of Stash-Hunter by omtoi, maintained by _og3.",
  "authors": [
    "omtoi",
    "_og3"
  ],
  "contact": {
    "sources": "https://github.com/papxx/StashhunterPort-by-_og3"
  },
  "icon": "assets/template/icon.png",
  "environment": "client",
  "license": "Apache-2.0",
  "entrypoints": {
    "meteor": [
      "com.stashhunter.stashhunter.StashHunter"
    ]
  },
  "mixins": [
    "addon-template.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "225,25,25"
  },
  "depends": {
    "java": ">=25",
    "minecraft": "${mc_version}",
    "meteor-client": "*",
    "fabric-networking-api-v1": "*",
    "fabric-api-base": "*"
  }
}
